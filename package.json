    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "jsdom": "^30.1.0",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.8",
    "puppeteer-core": "^25.11.0",
    "serve": "^14.2.6",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
